# APPLICATION
APP_NAME=AcademicPass Extraction Service
APP_VERSION=1.0.0
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8082
LOG_LEVEL=INFO

# KAFKA
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=extraction-service
KAFKA_INPUT_TOPIC=enade.pdfs.discovered
KAFKA_OUTPUT_TOPIC=enade.questions.structured
KAFKA_DLQ_TOPIC=enade.extraction.dlq
KAFKA_CLIENT_ID=academicpass-extraction

KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_POLL_TIMEOUT_SECONDS=1.0
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_MAX_POLL_INTERVAL_MS=300000

# PLAINTEXT, SSL, SASL_PLAINTEXT ou SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Configuração SASL/Kerberos
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SASL_KERBEROS_SERVICE_NAME=kafka
KAFKA_KERBEROS_KEYTAB=
KAFKA_KERBEROS_PRINCIPAL=

# PDF STORAGE
# minio ou local
PDF_STORAGE_BACKEND=minio
PDF_MAX_FILE_SIZE_MB=50

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=enade-documents
MINIO_SECURE=false
MINIO_REGION=

# Armazenamento local
# Obrigatório somente quando PDF_STORAGE_BACKEND=local
PDF_STORAGE_PATH=./storage/pdfs

# PDF PROCESSING
PDF_MAX_PAGES=1000
PDF_MIN_TEXT_CHARACTERS=1
PDF_PRESERVE_WHITESPACE=true
PDF_SORT_BLOCKS=true
PDF_EXTRACT_IMAGES_INFO=true

# GOOGLE AI STUDIO / GEMINI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_IMAGE_SIZE_MB=10

# RESILIENCE
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=30
RETRY_MULTIPLIER=2
RETRY_JITTER=true

# OBSERVABILITY
METRICS_ENABLED=true
METRICS_PATH=/metrics
HEALTH_PATH=/health
READINESS_PATH=/ready
