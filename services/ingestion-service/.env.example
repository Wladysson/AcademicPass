# Aplicação
APP_NAME=academicpass-ingestion-service
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

DOWNLOADER_TIMEOUT_SECONDS=30
DOWNLOADER_MAX_FILE_SIZE_MB=50
DOWNLOADER_MAX_RETRIES=3
DOWNLOADER_CHUNK_SIZE=65536

DOWNLOADER_ALLOWED_DOMAINS=gov.br,inep.gov.br

STORAGE_BACKEND=minio
STORAGE_MAX_FILE_SIZE_MB=50

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=academicpass-pdfs
MINIO_SECURE=false
MINIO_REGION=

LOCAL_STORAGE_PATH=./data/pdfs

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=enade.pdfs.discovered
KAFKA_CLIENT_ID=academicpass-ingestion-service

KAFKA_DELIVERY_TIMEOUT_SECONDS=30
KAFKA_REQUEST_TIMEOUT_MS=10000

KAFKA_SECURITY_PROTOCOL=PLAINTEXT

KAFKA_SASL_MECHANISM=

KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

KAFKA_KERBEROS_SERVICE_NAME=kafka

KAFKA_SSL_CA_LOCATION=

KRB5_CONFIG=/etc/krb5.conf
KRB5CCNAME=

METRICS_ENABLED=true
