APP_NAME=academicpass-indexing-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8084
APP_LOG_LEVEL=INFO

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=enade.questions.structured
KAFKA_GROUP_ID=academicpass-indexing-group
KAFKA_CLIENT_ID=academicpass-indexing-service
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_POLL_TIMEOUT=1.0

# Segurança Kafka
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_KERBEROS_SERVICE_NAME=
KAFKA_KERBEROS_PRINCIPAL=
KAFKA_KERBEROS_KEYTAB=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=academicpass-questions
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_REQUEST_TIMEOUT=30
ELASTICSEARCH_MAX_RETRIES=3

# Indexação em lote
BULK_CHUNK_SIZE=250
BULK_MAX_CHUNK_BYTES=5242880

# Política de repetição
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=1.0
RETRY_MAX_DELAY=30.0
RETRY_MULTIPLIER=2.0
RETRY_JITTER=true

# Dead Letter Queue (DLQ)
KAFKA_DLQ_TOPIC=enade.indexing.dlq

# Observabilidade
METRICS_ENABLED=true
METRICS_PATH=/metrics
